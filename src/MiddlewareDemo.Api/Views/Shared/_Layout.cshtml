<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Pharmacy Back Office</title>
    <style>
        body { font-family: Segoe UI, sans-serif; margin: 0; background: #f4f6f8; }
        header { background: #0b5c8a; color: #fff; padding: 12px 24px; }
        main { padding: 24px; }
        table { border-collapse: collapse; width: 100%; background: #fff; }
        td, th { border: 1px solid #d5dbe0; padding: 6px 10px; text-align: left; }
    </style>
</head>
<body>
    <header><strong>Pharmacy Back Office</strong></header>
    <main>
        @RenderBody()
    </main>
    <script src="~/js/admin.js"></script>
</body>
</html>
